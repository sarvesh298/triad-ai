# MongoDB connection string. URL-encode special characters in the password
# (e.g. "@" -> %40, ":" -> %3A, "/" -> %2F, "#" -> %23).
MONGO_URI=mongodb+srv://<username>:<url-encoded-password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=triad_dms

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Both are required and must be at least 32 characters.
JWT_SECRET_KEY=
FLASK_SECRET_KEY=
JWT_EXPIRES_MINUTES=60

# OCR. Leave TESSERACT_CMD / POPPLER_PATH empty if the tools are on PATH.
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#                  POPPLER_PATH=C:\poppler\Library\bin
OCR_LANG=eng
OCR_MAX_PAGES=50
TESSERACT_CMD=
POPPLER_PATH=

MAX_CONTENT_LENGTH=20971520

# Server. Never enable FLASK_DEBUG on a machine reachable by others.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Comma-separated allowed frontend origins, e.g. http://127.0.0.1:5500. Empty = allow all (dev only).
CORS_ORIGINS=

# New sign-ups need admin approval before they can log in.
# Set to false only if automated tests must log in straight after registering.
REQUIRE_ACCOUNT_APPROVAL=true
# Optional whitelist of divisions users may register into (empty = any).
DIVISIONS=Division A,Division B
